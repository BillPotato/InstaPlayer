# Copy to .env and fill in. The client must send this as: Authorization: Bearer <API_KEY>
API_KEY=replace-with-a-long-random-string

# Where the library DB, FLACs and album art are stored (inside the container).
DATA_DIR=/data

# Optional: Qobuz token to unlock hi-res downloads via SpotiFLAC.
# QOBUZ_TOKEN=

# Optional: override source priority (JSON list).
# DEFAULT_SERVICES=["tidal","qobuz","amazon","deezer"]
