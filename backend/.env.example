# Copy to .env and fill in. Only API_KEY is required — everything else has a
# sensible default. Full reference: "Backend configuration" in the README.

# Bearer token every client must send (Authorization: Bearer <API_KEY>).
# Use a long random value, e.g.:  openssl rand -hex 32
API_KEY=replace-with-a-long-random-string

# Where job files, the SQLite DB, logs and the engine home live (inside the
# container; docker-compose mounts ./data there).
DATA_DIR=/data

# Quality profile: LOSSLESS (16-bit) or HI_RES (24-bit).
# QUALITY=LOSSLESS

# Source priority for the engine. Only qobuz/tidal/amazon are download
# providers upstream (deezer is metadata/art only — no downloader).
# DEFAULT_SERVICES=["qobuz","tidal","amazon"]

# Engine retries per community-endpoint request on transient errors
# (429/502/504). 0 = one attempt, fail fast.
TRACK_MAX_RETRIES=1

# Optional: custom Qobuz API base URL (https://...) forwarded to the engine.
# Leave unset to use the built-in community endpoint.
# QOBUZ_TOKEN=

# How long a finished job's files are kept before auto-deletion.
# JOB_RETENTION_HOURS=6

# --- Community verification (the download captcha) ---------------------------
# The image is built WITH a browser (Chrome + xvfb) by default, so the engine
# can solve the verification captcha itself. Set this to 0 for the slim image —
# several hundred MB smaller, but then you have to supply the session file by
# hand every few hours.
# WITH_SOLVER=1

# Set false to skip automatic verification entirely: the engine then logs the
# challenge URL for an admin to solve by hand.
# AUTO_VERIFY=true

# Replace the solver invocation (JSON array, or a command line). The challenge
# URL is appended as the final argument.
# VERIFY_COMMAND=

# Seconds the browser stays open after the captcha passes, so the page can hand
# the grant back to the engine.
# VERIFY_HOLD_OPEN=5

# Route the solver's browser through a proxy. On a cloud host this is usually
# what makes verification work at all: the captcha scores the client, and a
# datacentre address is refused where a residential one passes.
#
# Only the browser uses it — downloads stay on the direct path, so a proxy
# billed by traffic costs a few MB per verification rather than gigabytes.
# Use a *sticky* session: one solve spans several requests that must share an
# exit address.
# PROXY_HOST=gw.provider.com
# PROXY_PORT=10000
# PROXY_LOGIN=
# PROXY_PASSWORD=
# PROXY_SCHEME=http
#
# Or as a single URL, which wins over the parts above. The split form exists
# so a password containing @ or : doesn't need escaping.
# VERIFY_PROXY=http://user:password@gate.example.com:8080

# Send the engine's own requests through the proxy too, not just the browser's.
# Turn this on whenever you set a proxy. The community API binds the session to
# the address that solved the captcha, so signing from anywhere else fails —
#   Tidal community API status 401: {"detail":"Signed request validation failed."}
# — even though the session is perfectly valid. It also gets Qobuz working from
# a datacentre host, which otherwise returns an Akamai 403.
#
# Requires a STICKY proxy session, or every request exits from a new address and
# the mismatch just moves around. Costs bandwidth: track downloads take the same
# route, so watch the meter if your proxy bills by traffic.
# PROXY_ENGINE=true

# Timezone the solver's browser reports. Scoring compares it against the
# address the request came from — through a proxy that's the *exit's*
# location, so the container's own TZ is wrong here by definition.
# "auto" (the default) resolves the exit and matches it, so a US proxy just
# works without touching TZ above. A zone name pins it; empty disables the
# override and the browser keeps the container's TZ.
# VERIFY_TIMEZONE=auto

# Timezone for the container, and so for the browser the solver drives. A
# container is UTC by default while its traffic leaves from wherever the host
# is; anti-bot scoring compares the two, and a mismatch counts against you.
# Set this to the host's zone — only the offset really matters.
# TZ=Asia/Bangkok

# Health probe: the track it downloads, per-run cap, and how often the
# periodic probe keeps the status fresh (0 disables; each probe downloads
# one real track).
# PROBE_SPOTIFY_URL=
# PROBE_TIMEOUT_SECONDS=240
# PROBE_INTERVAL_MINUTES=60

# Days of per-day log files (data/logs/) to keep; 0 = forever.
# LOG_RETENTION_DAYS=30

# Self-hosted public exposure only (docker-compose.public.yml): hostname that
# resolves to this server, for Caddy's automatic Let's Encrypt TLS. Not used
# by PaaS hosting (e.g. Zeabur) — the platform terminates TLS itself.
# DOMAIN=music.example.com
