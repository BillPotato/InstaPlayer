# Copy to .env and fill in. The client must send this as: Authorization: Bearer <API_KEY>
API_KEY=replace-with-a-long-random-string

# Where the library DB, FLACs and album art are stored (inside the container).
DATA_DIR=/data

# Optional: custom Qobuz API base URL (https://...) forwarded to the engine.
# Leave unset to use the built-in community endpoint.
# QOBUZ_TOKEN=

# Optional: override source priority (JSON list). Only qobuz/tidal/amazon are
# download providers upstream (deezer is metadata/art only — no downloader).
# DEFAULT_SERVICES=["qobuz","tidal","amazon"]

TRACK_MAX_RETRIES=1
