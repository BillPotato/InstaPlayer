# Copy to .env and fill in. Only API_KEY is required — everything else has a
# sensible default. Full reference: "Backend configuration" in the README.

# Bearer token every client must send (Authorization: Bearer <API_KEY>).
# Use a long random value, e.g.:  openssl rand -hex 32
API_KEY=replace-with-a-long-random-string

# Where job files, the SQLite DB, logs and the engine home live (inside the
# container; docker-compose mounts ./data there).
DATA_DIR=/data

# Quality profile: LOSSLESS (16-bit) or HI_RES (24-bit).
# QUALITY=LOSSLESS

# Source priority for the engine. Only qobuz/tidal/amazon are download
# providers upstream (deezer is metadata/art only — no downloader).
# DEFAULT_SERVICES=["qobuz","tidal","amazon"]

# Engine retries per community-endpoint request on transient errors
# (429/502/504). 0 = one attempt, fail fast.
TRACK_MAX_RETRIES=1

# Optional: custom Qobuz API base URL (https://...) forwarded to the engine.
# Leave unset to use the built-in community endpoint.
# QOBUZ_TOKEN=

# How long a finished job's files are kept before auto-deletion.
# JOB_RETENTION_HOURS=6

# --- Community verification (the download captcha) ---------------------------
# Set this to 1 so the image is BUILT with a browser (Chrome + xvfb), letting
# the engine solve the verification captcha itself. docker compose reads this
# file when interpolating the build args, so putting it here means every
# `docker compose build` keeps it — passing --build-arg by hand only applies to
# that one build, and the next plain rebuild silently drops the browser.
# Costs several hundred MB of image size.
WITH_SOLVER=1

# Set false to skip automatic verification entirely: the engine then logs the
# challenge URL for an admin to solve by hand.
# AUTO_VERIFY=true

# Replace the solver invocation (JSON array, or a command line). The challenge
# URL is appended as the final argument.
# VERIFY_COMMAND=

# Seconds the browser stays open after the captcha passes, so the page can hand
# the grant back to the engine.
# VERIFY_HOLD_OPEN=5

# Timezone for the container, and so for the browser the solver drives. A
# container is UTC by default while its traffic leaves from wherever the host
# is; anti-bot scoring compares the two, and a mismatch counts against you.
# Set this to the host's zone — only the offset really matters.
# TZ=Asia/Bangkok

# Health probe: the track it downloads, per-run cap, and how often the
# periodic probe keeps the status fresh (0 disables; each probe downloads
# one real track).
# PROBE_SPOTIFY_URL=
# PROBE_TIMEOUT_SECONDS=240
# PROBE_INTERVAL_MINUTES=60

# Days of per-day log files (data/logs/) to keep; 0 = forever.
# LOG_RETENTION_DAYS=30

# Self-hosted public exposure only (docker-compose.public.yml): hostname that
# resolves to this server, for Caddy's automatic Let's Encrypt TLS. Not used
# by PaaS hosting (e.g. Zeabur) — the platform terminates TLS itself.
# DOMAIN=music.example.com
